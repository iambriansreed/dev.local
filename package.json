{
    "name": "dev.local",
    "version": "0.1.1",
    "private": true,
    "license": "Apache-2.0",
    "description": "Local nginx proxy management for dev servers: a menu bar app, the dashboard server behind it, and the website that installs it.",
    "repository": {
        "type": "git",
        "url": "https://github.com/iambriansreed/dev.local.git"
    },
    "scripts": {
        "dev": "tsx .scripts/dev.ts",
        "dev:server": "tsx server/src/scripts/dev.ts",
        "dev:marketing": "cd web && npx skrapa dev",
        "build": "npm run build:server && cd web && skrapa build",
        "build:server": "tsc -p server",
        "server": "npm run build:server && node server/dist/server/index.js",
        "start": "npm run server",
        "release": "node .scripts/release.ts",
        "typecheck": "tsc -p .scripts",
        "test": "npm run test:server && npm run test:scripts",
        "test:server": "tsx --test \"server/src/**/*.test.ts\"",
        "test:scripts": "tsx --test \".scripts/**/*.test.ts\""
    },
    "devDependencies": {
        "@types/node": "26.6.4",
        "commit-and-tag-version": "12.7.3",
        "skrapa": "0.8.1",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=24"
    }
}
